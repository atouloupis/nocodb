# ============================================================================
# Fichier .env.example - Variables d'Environnement pour NocoDB
# ============================================================================
# Copiez ce fichier en .env et remplissez avec vos vraies valeurs
# IMPORTANT: Ne commitez JAMAIS le fichier .env avec vos secrets
# ============================================================================

# ----------------------------------------------------------------------------
# Configuration de la Base de Données
# ----------------------------------------------------------------------------

# PostgreSQL (format: pg://host:port?u=user&p=password&d=database)
NC_DB=pg://10.70.11.101:5432?u=test&p=test&d=test

# Autres exemples:
# MySQL: mysql2://host:port?u=user&p=password&d=database
# SQLite: sqlite:///path/to/database.db

# ----------------------------------------------------------------------------
# Sécurité
# ----------------------------------------------------------------------------

# Secret JWT pour l'authentification (CHANGEZ CETTE VALEUR!)
# Générez un nouveau secret avec: openssl rand -hex 32
NC_AUTH_JWT_SECRET=569a1821-0a93-45e8-87ab-eb857f20a010

# ----------------------------------------------------------------------------
# Configuration Application
# ----------------------------------------------------------------------------

# Port de l'application (interne au container)
PORT=8080

# URL publique de l'application (si derrière un reverse proxy)
# NC_PUBLIC_URL=https://nocodb.votre-domaine.com

# Désactiver la télémétrie
NC_DISABLE_TELE=true

# Mode production
NODE_ENV=production

# ----------------------------------------------------------------------------
# Limites et Quotas (Débloqués)
# ----------------------------------------------------------------------------

# Nombre maximum de pièces jointes par cellule
NC_MAX_ATTACHMENTS_ALLOWED=100

# Taille maximale des fichiers (en octets, 100MB)
NC_ATTACHMENT_FIELD_SIZE=104857600

# Taille maximale pour les champs non-attachments (100MB)
NC_NON_ATTACHMENT_FIELD_SIZE=104857600

# ----------------------------------------------------------------------------
# Redis (Optionnel - pour les sessions et cache)
# ----------------------------------------------------------------------------

# NC_REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------------
# Email (Optionnel - pour les invitations et notifications)
# ----------------------------------------------------------------------------

# NC_SMTP_FROM=noreply@votre-domaine.com
# NC_SMTP_HOST=smtp.gmail.com
# NC_SMTP_PORT=587
# NC_SMTP_USERNAME=votre-email@gmail.com
# NC_SMTP_PASSWORD=votre-mot-de-passe

# ----------------------------------------------------------------------------
# S3 Storage (Optionnel - pour stocker les fichiers sur S3)
# ----------------------------------------------------------------------------

# NC_S3_BUCKET_NAME=nocodb-attachments
# NC_S3_REGION=eu-west-1
# NC_S3_ACCESS_KEY=votre-access-key
# NC_S3_ACCESS_SECRET=votre-secret-key

# ----------------------------------------------------------------------------
# Autres Options
# ----------------------------------------------------------------------------

# Timezone
TZ=Europe/Paris

# Activer les logs debug (développement uniquement)
# DEBUG=*

# Désactiver les migrations automatiques
# NC_DISABLE_MIGRATIONS=false

# Admin Email (premier utilisateur)
# NC_ADMIN_EMAIL=admin@example.com

# Admin Password (premier utilisateur)
# NC_ADMIN_PASSWORD=SecurePassword123!

# ============================================================================
# NOTES:
# ============================================================================
#
# 1. Pour utiliser ce fichier:
#    cp .env.example .env
#    # Modifiez .env avec vos vraies valeurs
#
# 2. Docker Compose chargera automatiquement le fichier .env
#
# 3. Assurez-vous que .env est dans .gitignore
#
# 4. Pour les secrets sensibles en production, utilisez:
#    - Docker Secrets
#    - Kubernetes Secrets
#    - Vault
#    - Variables d'environnement du système
#
# ============================================================================
